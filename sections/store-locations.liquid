
<!-- html  -->
<div class="stores">  
    
    <div class="stores__top">
      <div class="container">
      
        <h1 class="tc">FIND YOUR DREAM CLOTHES AT NAUTICA!</h1>
        <div class="stores__tabs">
          <p>Popular Locations</p>
          <ul>
            {% for block in section.blocks %}
              {% if block.settings.tabName != ""  %}
                <li>{{ block.settings.tabName }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>      
      </div>      
    </div>
  
    <div class="container">
      <div class="stores__content">
        <div class="stores__left">
          <h2>Stores</h2>
  
            {% for block in section.blocks %}
              {% if block.settings.storeName != '' %}
                <div class="stores__details">
                  <p class="stores__name"><b>{{ block.settings.storeName }}</b></p>
                  <p class="stores__city">{{ block.settings.storeCity }}</p>
                  <p class="stores__timing">{{ block.settings.storeTiming }}</p>
                  <p class="stores__address">{{ block.settings.storeAddress }}</p>
                  <p class="stores__distance"><b>{{ block.settings.storeDistance }}</b></p>
                  <p class="stores__phone"> <i class="pegk pe-7s-call"></i> <a href="tel:{{ block.settings.storePhone }}">{{ block.settings.storePhone }}</a> </p>
                  <p class="stores__email"><i class="pegk pe-7s-mail"></i> <a href="mailto:{{ block.settings.storeEmail }}">{{ block.settings.storeEmail }}</a> </p>
                  <p class="stores__direction"><a href="{{ block.settings.storeDirectionUrl }}" target="_blank">GET DIRECTIONS</a></p>
                </div>
              {% endif %}
            {% endfor %}
          
        </div>
        <div class="stores__right">
          {% for block in section.blocks %}
            {% if block.settings.storeLocationIframe != '' %}
              <div class="stores__map">
                {{ block.settings.storeLocationIframe }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        
      </div>
    </div>
</div>

{% schema %}
    {
      "name": "store locations",
      "settings": [        
      ],
      "blocks":[
        {
          "type":"Combined-block",
          "name": "Map and Content",
          "settings":[
            {
              "type":"text",
              "id" : "tabName",
              "label":"Tab Name"
            },
            {
              "type":"text",
              "id" : "storeName",
              "label":"Store Name"
            },
            {
              "type":"text",
              "id" : "storeCity",
              "label":"Store City"
            },
            {
              "type":"text",
              "id" : "storeTiming",
              "label":"Store Timing"
            },
            {
              "type":"text",
              "id" : "storeAddress",
              "label":"Store Address"
            },
            {
              "type":"text",
              "id" : "storeDistance",
              "label":"Store Distance"
            },
            {
              "type":"text",
              "id" : "storePhone",
              "label":"Store Phone (with country code)"
            },
            {
              "type":"text",
              "id" : "storeEmail",
              "label":"Store Email"
            },
            {
              "type":"url",
              "id" : "storeDirectionUrl",
              "label":"Store Direction URL"
            },
            {
              "type":"textarea",
              "id" : "storeLocationIframe",
              "label":"Store Location Iframe"
            }
          ]
        }
      ]      
    }
  {% endschema %}





















